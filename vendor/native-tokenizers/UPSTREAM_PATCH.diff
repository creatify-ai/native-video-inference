+// Index vocabulary positions rather than duplicating every owned token string.
+// Chained buckets compare the full token, so collisions and duplicate spellings
+// preserve the upstream last-ID-wins lookup behavior exactly.
+#[derive(Clone)]
+struct TokenMap {
+    heads: Vec<usize>,
+    next: Vec<usize>,
+    hash_builder: RandomState,
+}
+impl TokenMap {
+    fn hash(&self, token: &str) -> usize {
+        let mut hasher = self.hash_builder.build_hasher();
+        token.hash(&mut hasher);
+        hasher.finish() as usize & (self.heads.len() - 1)
+    }
+    fn new(vocab: &Vocab) -> Result<Self> {
+        let capacity = vocab.len().saturating_mul(2).max(1).checked_next_power_of_two()
+            .ok_or("vocabulary index too large")?;
+        let mut out = Self { heads: vec![usize::MAX; capacity], next: Vec::with_capacity(vocab.len()),
+            hash_builder: RandomState::new() };
+        for (id, (token, _)) in vocab.iter().enumerate() {
+            let bucket = out.hash(token);
+            out.next.push(out.heads[bucket]);
+            out.heads[bucket] = id;
+        }
+        Ok(out)
+    }
+    fn get(&self, vocab: &Vocab, token: &str) -> Option<u32> {
+        let mut id = self.heads[self.hash(token)];
+        while id != usize::MAX {
+            if vocab[id].0 == token { return Some(id as u32); }
+            id = self.next[id];
+        }
+        None
+    }
+}
 
